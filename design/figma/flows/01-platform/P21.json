                      "name": "Paragraph",
                      "w": 494,
                      "h": 25,
                      "wSize": "fill",
                      "hSize": "hug",
                      "text": "2–8 players · 1–4 rounds",
                      "textStyle": "Zumpo/Body",
                      "fills": [
                        "$Zumpo · UI:color/ink"
                      ],
                      "autoResize": "height"
                    },
                    {
                      "type": "TEXT",
                      "id": "I163:66274;35:13437;163:66619",
                      "name": "Paragraph",
                      "w": 494,
                      "h": 100,
                      "wSize": "fill",
                      "hSize": "hug",
                      "text": "Everyone takes a turn to draw. One word category is used for the whole game, and everyone can see it.\nThe drawer has 15 seconds to pick one of 3 words. If time runs out, the first one is picked.",
                      "textStyle": "Zumpo/Body",
                      "fills": [
                        "$Zumpo · UI:color/ink"
                      ],
                      "autoResize": "height"
                    },
                    {
                      "type": "TEXT",
                      "id": "I163:66274;35:13437;163:66620",
                      "name": "Paragraph",
                      "w": 494,
                      "h": 75,
                      "wSize": "fill",
                      "hSize": "hug",
                      "text": "Everyone else has 90 seconds to type the word into the chat. Letters are revealed as the clock runs down. Once you get it, your chat locks until the next turn.",
                      "textStyle": "Zumpo/Body",
                      "fills": [
                        "$Zumpo · UI:color/ink"
                      ],
                      "autoResize": "height"
                    },
                    {
                      "type": "TEXT",
                      "id": "I163:66274;35:13437;163:66621",
                      "name": "Paragraph",
                      "w": 494,
                      "h": 75,
                      "wSize": "fill",
                      "hSize": "hug",
                      "text": "Faster guesses earn more, from 50 to 150 points, and the drawer gets two fifths of each. The answer is shown for 10 seconds, then the next turn starts.",
                      "textStyle": "Zumpo/Body",
                      "fills": [
                        "$Zumpo · UI:color/ink"
                      ],
                      "autoResize": "height"
                    }
