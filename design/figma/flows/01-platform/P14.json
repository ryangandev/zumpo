            "children": [
              {
                "type": "TEXT",
                "id": "79:104215",
                "name": "Title",
                "w": 580,
                "h": 30,
                "hSize": "hug",
                "text": "Daily Word",
                "textStyle": "Zumpo/Heading",
                "fills": [
