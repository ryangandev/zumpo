{
  "format": 1,
  "name": "Zumpo/Turn bar",
  "id": "26:16873",
  "type": "COMPONENT_SET",
  "key": "afc740a85a15447df5099f4555551bf122d3dbd4",
  "description": "Sits above the canvas in Draw & Guess and carries the turn: the game’s category (always shown, nested Tag), what to do, the word or the hint, and the phase clock. Word: the drawer sees the word. Hint: guessers see the server’s hint string as is (“__r___”, spaces kept for two-word answers), tracked out 30% so each blank reads as a slot; the server reveals letters at a third and two thirds of the drawing clock, up to a third of the word. Status: choosing, review, waiting. Replaces putting the word or hint in a page Notice. Phone layout: the clock moves up beside the category, and the answer wraps under the label. Category, Countdown, Top row: off when the game has no category (a game on your own), nothing is timed, or (Phone) neither shows.",
  "properties": {
    "Label": {
      "type": "text",
      "default": "Guess the word"
    },
    "Main": {
      "type": "text",
      "default": "__r___"
    },
    "Meta": {
      "type": "text",
      "default": "6 letters"
    },
    "Category": {
      "type": "boolean",
      "default": true
    },
    "Countdown": {
      "type": "boolean",
      "default": true
    },
    "Kind": {
      "type": "variant",
      "default": "Word",
      "options": [
        "Word",
        "Hint",
        "Status"
      ]
    },
    "Layout": {
      "type": "variant",
      "default": "Desktop",
      "options": [
        "Desktop",
        "Phone"
      ]
    }
  },
  "defaultVariant": "Kind=Word, Layout=Desktop",
