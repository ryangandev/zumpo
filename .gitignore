# Dependencies
node_modules/

# Build output: the server compiles into server/build/, and Vite builds the
# client into server/build/public/.
server/build/
*.tsbuildinfo

# shared/ is TypeScript only; the server compiles it into server/build/shared/.
# A stray .js here would shadow the .ts for Vite, so it is never committed.
shared/**/*.js

# Local environment overrides, such as client/.env.local
.env
.env.*

# Logs
*.log

# Test output: coverage, and the traces and screenshots of failed browser checks
coverage/
test-results/
playwright-report/

# Figma export previews: regenerated on every export, too heavy for history.
# The JSON and SVG beside them are committed. See docs/design.md.
design/figma/previews/

# What npm run audio:build leaves only when it is stopped mid-swap.
client/src/audio/.generated-*/

# Captures from npm run design:compare, beside the Figma previews they match.
design/compare/

# Editors and the OS. The shared VS Code settings are committed.
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code local config (launch targets, settings, session state)
.claude/
